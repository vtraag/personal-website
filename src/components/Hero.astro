---
import SocialIcons from './SocialIcons.astro';
import Portrait from './Portrait.astro';
const { name, tagline } = Astro.props;
---

<section class="hero">
  <div class="hero-content">
    <div class="portrait-container">
      <Portrait alt={name} class="portrait" sizes="(max-width: 960px) min(250px, 80vw), 450px" />
    </div>
    <div class="hero-text">
      <h1>{name}</h1>
      <p class="tagline">{tagline}</p>
      <SocialIcons
        size={40}
        gap="1.5rem"
      />
    </div>
  </div>
</section>
